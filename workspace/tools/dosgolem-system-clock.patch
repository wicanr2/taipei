+package dos
+
+import (
+	"bytes"
+	"testing"
+
+	"github.com/wicanr2/dosgolem/internal/cpu"
+)
+
+// #40：DOS 系統時間與 INT1A 共用 BIOS 計數；raw PIT IRQ 不是系統時鐘。
+func TestDOSSystemClockUsesBIOSTicks(t *testing.T) {
+	for _, rawIRQs := range []uint64{0, 18, 7200, 100000} {
+		m, d := newTest(t)
+		m.Ticks = rawIRQs
+		m.Write16(0x46c, 18)
+		if got := d.clock(); got != (Time{Sec: 0, Hundredth: 98}) {
+			t.Errorf("raw IRQ=%d，BIOS=18：時間=%+v，預期 00:00:00.98", rawIRQs, got)
+		}
+		m.Write16(0x46c, 182)
+		if got := d.clock(); got != (Time{Sec: 9, Hundredth: 99}) {
+			t.Errorf("BIOS=182：時間=%+v，預期 00:00:09.99", got)
+		}
+	}
+}
+
+func TestDOSSystemClockInt1ASetAndTimeRegisters(t *testing.T) {
+	m, d := newTest(t)
+	m.Ticks = 700000
+	m.CPU.R[cpu.CX], m.CPU.R[cpu.DX] = 1, 6464 // 72000 BIOS ticks
+	call(m, d, 0x1a, 0x0100)
+	call(m, d, 0x21, 0x2c00)
+	if m.CPU.R[cpu.CX] != 0x0105 || m.CPU.R[cpu.DX] != 0x3660 {
+		t.Fatalf("DOS 時間 CX=%04x DX=%04x，預期 01:05:54.96", m.CPU.R[cpu.CX], m.CPU.R[cpu.DX])
+	}
+	call(m, d, 0x1a, 0)
+	if m.CPU.R[cpu.CX] != 1 || m.CPU.R[cpu.DX] != 6464 {
+		t.Fatal("DOS 讀時鐘不得修改 BIOS 計數")
+	}
+}
+
+func TestDOSSystemClockInitialOffsetAndDayRemainder(t *testing.T) {
+	m, d := newTest(t)
+	d.Now = Time{Hour: 23, Min: 59, Sec: 59, Hundredth: 99}
+	if got := d.clock(); got != d.Now {
+		t.Fatalf("初始時間遺失：%+v", got)
+	}
+	m.Ticks = 900000
+	m.Write16(0x46c, 1)
+	if got := d.clock(); got != (Time{Hundredth: 4}) {
+		t.Fatalf("跨日餘數=%+v，預期 00:00:00.04", got)
+	}
+}
+
+func TestDOSSystemClockMachineAndDOSState(t *testing.T) {
+	m, d := newTest(t)
+	m.Write16(0x46c, 1000)
+	m.Ticks = 90000
+	d.Now = Time{Hour: 2, Min: 3, Sec: 4, Hundredth: 5}
+	want := Time{Hour: 2, Min: 3, Sec: 58, Hundredth: 98}
+	if got := d.clock(); got != want {
+		t.Fatalf("快照前時間=%+v，預期 %+v", got, want)
+	}
+	var machineState, dosState bytes.Buffer
+	if err := m.SaveState(&machineState); err != nil {
+		t.Fatal(err)
+	}
+	if err := d.SaveState(&dosState); err != nil {
+		t.Fatal(err)
+	}
+	m.Write16(0x46c, 0)
+	m.Ticks = 0
+	d.Now = Time{}
+	if err := m.LoadState(&machineState); err != nil {
+		t.Fatal(err)
+	}
+	if err := d.LoadState(&dosState); err != nil {
+		t.Fatal(err)
+	}
+	if got := d.clock(); got != want {
+		t.Fatalf("快照後時間=%+v，預期 %+v", got, want)
+	}
+}
