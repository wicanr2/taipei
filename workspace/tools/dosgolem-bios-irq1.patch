index 670d336d5c0205ea61b26075ced4e668a07a897f..811dd370aaf1935fe25a4a18ea05be923a81b529 100644
--- a/internal/dos/int9_test.go
+++ b/internal/dos/int9_test.go
@@ -116,3 +116,30 @@ func TestBiosInt9OnlyForOwnStub(t *testing.T) {
 		t.Error("程式自己的 ISR 在跑時不該有人替它填 BDA 緩衝")
 	}
 }
+
+// 走完整硬體佇列與預設向量，避免只直接呼叫 biosInt9 而漏驗 IRQ1 路由。
+func TestBiosInt9HardwareQueueDefaultVector(t *testing.T) {
+	m, d := newTest(t)
+	if err := m.LoadCOM([]byte{0xEB, 0xFE}); err != nil {
+		t.Fatal(err)
+	}
+	d.Install()
+	m.CPU.SetFlags(cpu.IF)
+	m.KeyEvery = 20
+	m.SetNextKey(0)
+	m.QueueScanCodes(0x1C, 0x9C)
+	for i := 0; i < 100; i++ {
+		if err := m.Step(); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if got := m.IRQ1Delivered(); got != 2 {
+		t.Fatalf("預設 BIOS 向量送達 %d 次 IRQ1，預期通碼與斷碼各一次", got)
+	}
+	if got := m.BIOSKeyCount(); got != 1 {
+		t.Fatalf("緩衝有 %d 個鍵，預期只有通碼產生一個", got)
+	}
+	if got := readKey(t, d); got != 0x1C0D {
+		t.Fatalf("收到 %04X，預期 Enter 1C0D", got)
+	}
+}
