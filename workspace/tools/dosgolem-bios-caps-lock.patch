diff --git a/internal/dos/caps_lock_test.go b/internal/dos/caps_lock_test.go
new file mode 100644
index 0000000..9d0f4d4
--- /dev/null
+++ b/internal/dos/caps_lock_test.go
@@ -0,0 +1,41 @@
+package dos
+
+import "testing"
+
+func TestCapsLockToggleAndTranslation(t *testing.T) {
+	m, d := newTest(t)
+	send := func(code byte) { m.SetKeyPort(code); d.biosInt9(m.CPU) }
+	send(0x3a)
+	send(0x3a)
+	if m.Read8(0x417)&64 == 0 || m.Read8(0x418)&64 == 0 {
+		t.Fatal("Caps make must latch once")
+	}
+	send(0xba)
+	if m.Read8(0x418)&64 != 0 {
+		t.Fatal("Caps release must clear held state")
+	}
+	for _, code := range []byte{0x1e, 0x02, 0x2a, 0x1e, 0x02, 0xaa, 0x1d, 0x1e, 0x9d} {
+		send(code)
+	}
+	var got []byte
+	for {
+		w, ok := m.PopKey()
+		if !ok {
+			break
+		}
+		got = append(got, byte(w))
+	}
+	if string(got) != "A1a!\x01" {
+		t.Fatalf("BIOS read %q", got)
+	}
+	send(0x3a)
+	send(0xba)
+	send(0x1e)
+	if m.Read8(0x417)&64 != 0 {
+		t.Fatal("Second Caps press must unlock")
+	}
+	w, ok := m.PopKey()
+	if !ok || byte(w) != 'a' {
+		t.Fatalf("unlocked key %x", w)
+	}
+}
