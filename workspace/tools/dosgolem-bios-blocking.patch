--- a/internal/dos/bios.go
+++ b/internal/dos/bios.go
@@ -304,6 +304,7 @@ func (d *DOS) int16(c *cpu.CPU) {
 	switch ah(c) {
 	case 0x00, 0x10: // 讀按鍵（真 BIOS 是阻塞的）
 		d.KeyPolls++
+		d.Blocked = false
 		// **BDA 的環形緩衝優先。** 那是 BIOS 真正的鍵盤佇列，
 		// 程式也可能繞過 int 16h 直接讀它（見 machine.PushBIOSKey）；
 		// 兩邊各留一份的話，同一個鍵會被讀兩次。
@@ -321,6 +322,12 @@ func (d *DOS) int16(c *cpu.CPU) {
 			return
 		}
 		if len(d.Stdin) == 0 {
+			if d.BlockingBIOSKeys {
+				d.KeyWaits++
+				d.Blocked = true
+				c.Rewind()
+				return
+			}
 			c.R[cpu.AX] = 0
 			return
 		}
diff --git a/internal/dos/bios_blocking_test.go b/internal/dos/bios_blocking_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..04e8e3fc2eb105f22a096c5923ce595c735021a3
--- /dev/null
+++ b/internal/dos/bios_blocking_test.go
@@ -0,0 +1,49 @@
+package dos
+
+import (
+	"testing"
+
+	"github.com/wicanr2/dosgolem/internal/cpu"
+)
+
+func TestBlockingBIOSReadWaitsAndResumesFromHardware(t *testing.T) {
+	for _, ah := range []byte{0x00, 0x10} {
+		m, d := newTest(t)
+		if err := m.LoadCOM([]byte{0xB4, ah, 0xCD, 0x16, 0xA3, 0x00, 0x02, 0xEB, 0xFE}); err != nil {
+			t.Fatal(err)
+		}
+		d.Install()
+		d.BlockingBIOSKeys = true
+		m.CPU.R[cpu.AX] = 0x00A5
+		m.CPU.SetFlags(cpu.IF)
+		m.Write16(0x1200, 0xABCD)
+		for i := uint64(0); i < 2*m.IRQ0Every+100; i++ {
+			if err := m.Step(); err != nil {
+				t.Fatal(err)
+			}
+		}
+		if !d.Blocked || d.KeyWaits == 0 || m.Read16(0x1200) != 0xABCD {
+			t.Fatalf("AH=%02X 空讀已向後執行：IP=%04X Blocked=%v", ah, m.CPU.IP, d.Blocked)
+		}
+		if m.CPU.R[cpu.AX] != uint16(ah)<<8|0xA5 {
+			t.Fatal("等待時不得偽造 AX")
+		}
+		if m.Ticks == 0 {
+			t.Fatal("等待時 BIOS 計時器仍須前進")
+		}
+		m.KeyEvery = 20
+		m.SetNextKey(m.Steps)
+		m.QueueScanCodes(0x39, 0xB9)
+		for i := 0; i < 100; i++ {
+			if err := m.Step(); err != nil {
+				t.Fatal(err)
+			}
+		}
+		if got := m.Read16(0x1200); got != 0x3920 {
+			t.Fatalf("AH=%02X 收到 %04X，預期空白鍵 3920", ah, got)
+		}
+		if d.Blocked || d.KeysConsumed != 1 || m.BIOSKeyCount() != 0 || m.IRQ1Delivered() != 2 {
+			t.Fatal("按下與放開只能解除一次等待")
+		}
+	}
+}
