diff --git a/audio/ymfm/synth.go b/audio/ymfm/synth.go
new file mode 100644
index 0000000..e7d22b1
--- /dev/null
+++ b/audio/ymfm/synth.go
@@ -0,0 +1,46 @@
+// Package ymfm provides an optional C++14 YM3812 backend.
+// See LICENSE and source.json for the unmodified third-party core.
+package ymfm
+
+/*
+#cgo CXXFLAGS: -std=c++14 -O2
+#cgo linux LDFLAGS: -lstdc++
+#cgo darwin LDFLAGS: -lc++
+#cgo windows LDFLAGS: -lstdc++ -static-libgcc -static-libstdc++ -static
+#include "bridge.h"
+*/
+import "C"
+import (
+	"fmt"
+	"unsafe"
+)
+
+type Synth struct{ ptr unsafe.Pointer }
+
+func New(rate int) (*Synth, error) {
+	if rate < 8000 || rate > 192000 {
+		return nil, fmt.Errorf("invalid OPL sample rate %d", rate)
+	}
+	p := C.dg_opl_new(C.uint32_t(rate))
+	if p == nil {
+		return nil, fmt.Errorf("OPL allocation failed")
+	}
+	return &Synth{p}, nil
+}
+func (s *Synth) Write(reg, val byte) {
+	if s.ptr != nil {
+		C.dg_opl_write(s.ptr, C.uint8_t(reg), C.uint8_t(val))
+	}
+}
+func (s *Synth) Sample() int32 {
+	if s.ptr == nil {
+		return 0
+	}
+	return int32(C.dg_opl_sample(s.ptr))
+}
+func (s *Synth) Close() {
+	if s.ptr != nil {
+		C.dg_opl_free(s.ptr)
+		s.ptr = nil
+	}
+}
