diff --git a/audio/ring.go b/audio/ring.go
new file mode 100644
index 0000000..9568d17
--- /dev/null
+++ b/audio/ring.go
@@ -0,0 +1,71 @@
+package audio
+
+import (
+	"fmt"
+	"sync"
+)
+
+// Ring is an io.Reader of signed stereo PCM16, with a fixed byte capacity.
+// Underflow returns silence; overflow rejects the complete incoming block.
+type Ring struct {
+	mu                  sync.Mutex
+	buf                 []byte
+	head, used          int
+	closed              bool
+	underflow, rejected uint64
+}
+
+func NewRing(frames int) (*Ring, error) {
+	if frames < 1 || frames > 192000 {
+		return nil, fmt.Errorf("invalid ring capacity")
+	}
+	return &Ring{buf: make([]byte, frames*4)}, nil
+}
+func (r *Ring) Push(p []byte) error {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	if r.closed {
+		return fmt.Errorf("audio ring closed")
+	}
+	if len(p)%4 != 0 {
+		return fmt.Errorf("PCM must contain complete stereo frames")
+	}
+	if len(p) > len(r.buf)-r.used {
+		r.rejected += uint64(len(p))
+		return fmt.Errorf("audio ring overflow")
+	}
+	for _, v := range p {
+		r.buf[(r.head+r.used)%len(r.buf)] = v
+		r.used++
+	}
+	return nil
+}
+func (r *Ring) Read(p []byte) (int, error) {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	n := len(p)
+	if n > r.used {
+		n = r.used
+	}
+	for i := 0; i < n; i++ {
+		p[i] = r.buf[r.head]
+		r.head = (r.head + 1) % len(r.buf)
+	}
+	r.used -= n
+	clear(p[n:])
+	r.underflow += uint64(len(p) - n)
+	return len(p), nil
+}
+func (r *Ring) Close() { r.mu.Lock(); defer r.mu.Unlock(); r.closed = true; r.used = 0; clear(r.buf) }
+
+type RingStats struct {
+	Capacity, Buffered         int
+	SilentBytes, RejectedBytes uint64
+	Closed                     bool
+}
+
+func (r *Ring) Stats() RingStats {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	return RingStats{len(r.buf), r.used, r.underflow, r.rejected, r.closed}
+}
diff --git a/audio/stream.go b/audio/stream.go
new file mode 100644
index 0000000..418fc1d
--- /dev/null
+++ b/audio/stream.go
@@ -0,0 +1,175 @@
+// Generic presentation audio; contract: docs/spec/204-opl2-audio-stream.md.
+package audio
+
+import (
+	"encoding/binary"
+	"fmt"
+	"math"
+
+	dg "github.com/wicanr2/dosgolem"
+	"github.com/wicanr2/dosgolem/internal/machine"
+)
+
+// Synth produces one mono sample per output frame; calls belong to one goroutine.
+type Synth interface {
+	Write(reg, val byte)
+	Sample() int32
+}
+
+// StepsPerSecond is the pinned executor's nominal instruction clock.
+func StepsPerSecond() float64 { return machine.StepsPerSecond() }
+
+type Port struct {
+	Step   uint64
+	Number uint16
+	Value  byte
+}
+type OPL struct {
+	Step             uint64
+	Bank, Reg, Value byte
+}
+
+// Stream consumes observation events and never writes to the emulated machine.
+type Stream struct {
+	rate        int
+	sps         float64
+	synth       Synth
+	frame, last uint64
+	tone        speaker
+}
+
+func New(rate int, sps float64, synth Synth) (*Stream, error) {
+	if rate < 8000 || rate > 192000 || sps <= 0 || math.IsNaN(sps) || math.IsInf(sps, 0) || synth == nil {
+		return nil, fmt.Errorf("invalid audio parameters")
+	}
+	return &Stream{rate: rate, sps: sps, synth: synth, tone: speaker{rw: 3, lowNext: true}}, nil
+}
+
+func (s *Stream) Render(until uint64, opl []OPL, ports []Port) ([]byte, error) {
+	if until < s.last || float64(until-s.last) > s.sps*2 {
+		return nil, fmt.Errorf("audio interval out of range")
+	}
+	for i, e := range opl {
+		if e.Bank != 0 || e.Step < s.last || e.Step > until || i > 0 && e.Step < opl[i-1].Step {
+			return nil, fmt.Errorf("invalid OPL event")
+		}
+	}
+	for i, e := range ports {
+		if e.Step < s.last || e.Step > until || i > 0 && e.Step < ports[i-1].Step {
+			return nil, fmt.Errorf("invalid port event")
+		}
+	}
+	target := uint64(math.Floor(float64(until) * float64(s.rate) / s.sps))
+	pcm := make([]byte, (target-s.frame)*4)
+	oi, pi := 0, 0
+	apply := func(step uint64) {
+		for oi < len(opl) && opl[oi].Step <= step {
+			e := opl[oi]
+			s.synth.Write(e.Reg, e.Value)
+			oi++
+		}
+		for pi < len(ports) && ports[pi].Step <= step {
+			s.tone.feed(ports[pi])
+			pi++
+		}
+	}
+	for i := 0; s.frame < target; s.frame++ {
+		step := uint64(math.Ceil(float64(s.frame+1) * s.sps / float64(s.rate)))
+		apply(step)
+		v := int(s.synth.Sample()) + s.tone.sample(s.rate)
+		if v > 32767 {
+			v = 32767
+		}
+		if v < -32768 {
+			v = -32768
+		}
+		binary.LittleEndian.PutUint16(pcm[i:], uint16(int16(v)))
+		binary.LittleEndian.PutUint16(pcm[i+2:], uint16(int16(v)))
+		i += 4
+	}
+	// Register writes after the last completed sample still belong to this batch.
+	apply(until)
+	s.last = until
+	return pcm, nil
+}
+
+// Drain copies only audio observations, then releases consumed log storage.
+// Registers, RAM, VGA and hardware configuration remain owned by dosgolem.
+func (s *Stream) Drain(m *dg.Machine) ([]byte, error) {
+	opl := make([]OPL, len(m.OPL))
+	for i, e := range m.OPL {
+		opl[i] = OPL{e.Step, e.Bank, e.Reg, e.Val}
+	}
+	ports := make([]Port, 0)
+	for _, e := range m.PortLog {
+		if e.Port == 0x42 || e.Port == 0x43 || e.Port == 0x61 {
+			ports = append(ports, Port{e.Step, e.Port, e.Val})
+		}
+	}
+	pcm, err := s.Render(m.Steps, opl, ports)
+	if err == nil {
+		m.ClearOPL()
+		m.PortLog = m.PortLog[:0]
+		m.Speaker = m.Speaker[:0]
+	}
+	return pcm, err
+}
+
+// PIT channel 2 tone contract; modes 2/3 are sound approximations, no ISR RE.
+type speaker struct {
+	rw, lo, mode, data byte
+	lowNext, set       bool
+	div                uint32
+	phase, dc          float64
+}
+
+func (s *speaker) feed(p Port) {
+	switch p.Number {
+	case 0x43:
+		if p.Value>>6 != 2 || p.Value>>4&3 == 0 {
+			return
+		}
+		s.rw, s.mode, s.lowNext = p.Value>>4&3, p.Value>>1&7, true
+	case 0x42:
+		switch s.rw {
+		case 1:
+			s.div = uint32(p.Value)
+			s.set = true
+		case 2:
+			s.div = uint32(p.Value) << 8
+			s.set = true
+		case 3:
+			if s.lowNext {
+				s.lo = p.Value
+				s.lowNext = false
+				return
+			}
+			s.div = uint32(s.lo) | uint32(p.Value)<<8
+			s.lowNext = true
+			s.set = true
+		}
+	case 0x61:
+		s.data = p.Value & 3
+	}
+}
+func (s *speaker) sample(rate int) int {
+	v := 0.0
+	if s.data == 3 && s.set && (s.mode == 2 || s.mode == 3 || s.mode == 6 || s.mode == 7) {
+		div := s.div
+		if div == 0 {
+			div = 65536
+		}
+		if s.phase < .5 {
+			v = 4096
+		} else {
+			v = -4096
+		}
+		s.phase += machine.PITBaseHz / float64(div) / float64(rate)
+		s.phase -= math.Floor(s.phase)
+	} else if s.data&1 == 0 && s.data&2 != 0 {
+		v = 4096
+	}
+	// DC blocker for direct one-bit data writes; no host wall-clock dependency.
+	s.dc += (v - s.dc) * .002
+	return int(v - s.dc)
+}
diff --git a/audio/stream_test.go b/audio/stream_test.go
new file mode 100644
index 0000000..ae07f77
--- /dev/null
+++ b/audio/stream_test.go
@@ -0,0 +1,161 @@
+package audio_test
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"encoding/binary"
+	"fmt"
+	"testing"
+
+	dg "github.com/wicanr2/dosgolem"
+	a "github.com/wicanr2/dosgolem/audio"
+	"github.com/wicanr2/dosgolem/audio/ymfm"
+)
+
+func synth(t *testing.T) *ymfm.Synth {
+	t.Helper()
+	s, e := ymfm.New(48000)
+	if e != nil {
+		t.Fatal(e)
+	}
+	t.Cleanup(s.Close)
+	return s
+}
+func note() []a.OPL {
+	// OPL2 channel 7 percussion: snare (BD bit3), envelope and frequency.
+	var out []a.OPL
+	for _, rv := range [][2]byte{{1, 0x20}, {0x31, 1}, {0x34, 1}, {0x51, 0}, {0x54, 0}, {0x71, 0xf0}, {0x74, 0xf0}, {0x91, 0xf7}, {0x94, 0xf7}, {0xa7, 0x80}, {0xb7, 0x11}, {0xbd, 0x28}} {
+		out = append(out, a.OPL{Step: 0, Reg: rv[0], Value: rv[1]})
+	}
+	out = append(out, a.OPL{Step: 100001, Reg: 0xbd, Value: 0x20})
+	return out
+}
+func TestRhythmAndChunkContinuity(t *testing.T) {
+	full, _ := a.New(48000, 1e6, synth(t))
+	want, e := full.Render(300000, note(), nil)
+	if e != nil {
+		t.Fatal(e)
+	}
+	chunk, _ := a.New(48000, 1e6, synth(t))
+	var got []byte
+	var start uint64
+	for _, end := range []uint64{17, 73, 19999, 100000, 100005, 120031, 200000, 300000} {
+		var events []a.OPL
+		for _, v := range note() {
+			if v.Step >= start && v.Step < end || end == 300000 && v.Step == end {
+				events = append(events, v)
+			}
+		}
+		p, e := chunk.Render(end, events, nil)
+		if e != nil {
+			t.Fatal(e)
+		}
+		got = append(got, p...)
+		start = end
+	}
+	if !bytes.Equal(want, got) {
+		t.Fatalf("chunk PCM changed: %x %x", sha256.Sum256(want), sha256.Sum256(got))
+	}
+	if len(want) != 14400*4 {
+		t.Fatal(len(want))
+	}
+	var first, last int64
+	for i := 0; i < len(want); i += 4 {
+		v := int64(int16(binary.LittleEndian.Uint16(want[i:])))
+		if i < 4800*4 {
+			first += v * v
+		}
+		if i >= 12000*4 {
+			last += v * v
+		}
+	}
+	if first == 0 || last >= first {
+		t.Fatalf("rhythm must sound then decay: %d %d", first, last)
+	}
+}
+func TestSpeakerAndInvalidEvents(t *testing.T) {
+	s, _ := a.New(48000, 1e6, synth(t))
+	p, e := s.Render(100000, nil, []a.Port{{0, 0x43, 0xb6}, {0, 0x42, 0xa9}, {0, 0x42, 4}, {0, 0x61, 3}, {50000, 0x61, 0}})
+	if e != nil {
+		t.Fatal(e)
+	}
+	var edges int
+	var prev int16
+	for i := 4; i < 4800*2; i += 4 {
+		v := int16(binary.LittleEndian.Uint16(p[i:]))
+		if (v < 0) != (prev < 0) {
+			edges++
+		}
+		prev = v
+	}
+	if edges < 90 || edges > 110 {
+		t.Fatal("1 kHz speaker edges", edges)
+	}
+	if _, e = s.Render(99999, nil, nil); e == nil {
+		t.Fatal("backward time accepted")
+	}
+	if _, e = s.Render(3100000, nil, nil); e == nil {
+		t.Fatal("unbounded allocation accepted")
+	}
+	if _, e = s.Render(200000, []a.OPL{{Step: 100001, Bank: 1}}, nil); e == nil {
+		t.Fatal("OPL3 silently accepted")
+	}
+}
+func TestDrainLeavesMachineState(t *testing.T) {
+	m := dg.New()
+	m.SetAdLib(true)
+	m.Steps = 100000
+	m.Out8(0x388, 0xbd)
+	m.Out8(0x389, 0x28)
+	m.Out8(0x61, 0)
+	hash := func() string {
+		h := sha256.New()
+		for i := uint32(0); i < 1<<20; i++ {
+			h.Write([]byte{m.Read8(i)})
+		}
+		return fmt.Sprintf("%x", h.Sum(nil))
+	}
+	before := hash()
+	r, seg, ip := m.CPU.R, m.CPU.Seg, m.CPU.IP
+	regs := m.OPLRegs(0)
+	pal := m.Palette()
+	frame := append([]byte(nil), m.Indexed()...)
+	s, _ := a.New(48000, 1e6, synth(t))
+	if _, e := s.Drain(m); e != nil {
+		t.Fatal(e)
+	}
+	if before != hash() || r != m.CPU.R || seg != m.CPU.Seg || ip != m.CPU.IP || regs != m.OPLRegs(0) || pal != m.Palette() || !bytes.Equal(frame, m.Indexed()) {
+		t.Fatal("audio mutated emulated state")
+	}
+	if len(m.OPL) != 0 || len(m.PortLog) != 0 {
+		t.Fatal("observations grew after consumption")
+	}
+}
+func TestRingBoundedAndClosed(t *testing.T) {
+	r, e := a.NewRing(2)
+	if e != nil {
+		t.Fatal(e)
+	}
+	if e = r.Push([]byte{1, 2, 3, 4, 5, 6, 7, 8}); e != nil {
+		t.Fatal(e)
+	}
+	if e = r.Push([]byte{9, 10, 11, 12}); e == nil {
+		t.Fatal("overflow accepted")
+	}
+	p := make([]byte, 12)
+	n, e := r.Read(p)
+	if e != nil || n != 12 || !bytes.Equal(p, []byte{1, 2, 3, 4, 5, 6, 7, 8, 0, 0, 0, 0}) {
+		t.Fatal(n, e, p)
+	}
+	r.Close()
+	if e = r.Push([]byte{1, 2, 3, 4}); e == nil {
+		t.Fatal("closed push accepted")
+	}
+	r.Read(p)
+	if !bytes.Equal(p, make([]byte, 12)) {
+		t.Fatal("closed reader not silent")
+	}
+	if s := r.Stats(); s.Capacity != 8 || s.Buffered != 0 || s.RejectedBytes != 4 || !s.Closed {
+		t.Fatal(s)
+	}
+}
