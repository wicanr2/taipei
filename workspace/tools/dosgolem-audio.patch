diff --git a/audio/ymfm/bridge.cpp b/audio/ymfm/bridge.cpp
new file mode 100644
index 0000000..dce5a87
--- /dev/null
+++ b/audio/ymfm/bridge.cpp
@@ -0,0 +1,33 @@
+// Generic YM3812 adapter. Upstream source and BSD license are kept alongside.
+#include "bridge.h"
+#include "ymfm_opl.h"
+#include <new>
+struct state {
+    ymfm::ymfm_interface intf;
+    ymfm::ym3812 chip;
+    uint64_t phase=0;
+    uint32_t rate;
+    int32_t last=0;
+    explicit state(uint32_t r):chip(intf),rate(r) { chip.reset(); }
+};
+extern "C" void *dg_opl_new(uint32_t rate) {
+    if(rate<8000 || rate>192000) return nullptr;
+    return new(std::nothrow) state(rate);
+}
+extern "C" void dg_opl_free(void *p) { delete static_cast<state *>(p); }
+extern "C" void dg_opl_write(void *p,uint8_t reg,uint8_t value) {
+    state *s=static_cast<state *>(p);
+    s->chip.write_address(reg); s->chip.write_data(value);
+}
+extern "C" int32_t dg_opl_sample(void *p) {
+    state *s=static_cast<state *>(p);
+    s->phase+=3579545;
+    const uint64_t period=uint64_t(s->rate)*72;
+    while(s->phase>=period) {
+        ymfm::ym3812::output_data sample;
+        s->chip.generate(&sample);
+        s->last=sample.data[0];
+        s->phase-=period;
+    }
+    return s->last;
+}
