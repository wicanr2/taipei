+
+//-------------------------------------------------
+//  reset - reset the channel state
+//-------------------------------------------------
+
+void adpcm_a_channel::reset()
+{
+	m_playing = 0;
+	m_curnibble = 0;
+	m_curbyte = 0;
+	m_curaddress = 0;
+	m_accumulator = 0;
+	m_step_index = 0;
+}
