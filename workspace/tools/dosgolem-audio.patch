+
+adpcm_a_channel::adpcm_a_channel(adpcm_a_engine &owner, uint32_t choffs, uint32_t addrshift) :
+	m_choffs(choffs),
+	m_address_shift(addrshift),
+	m_playing(0),
+	m_curnibble(0),
+	m_curbyte(0),
+	m_curaddress(0),
+	m_accumulator(0),
+	m_step_index(0),
+	m_regs(owner.regs()),
+	m_owner(owner)
+{
+}
