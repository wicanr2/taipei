+func (d *DOS) consoleReady() bool {
+	return d.consoleHasScan || d.M.BIOSKeyCount() > 0 || len(d.Keys) > 0 || len(d.Stdin) > 0
+}
+
+// readConsoleKey 共用 BIOS 的實體鍵盤來源。延伸鍵依 DOS 契約分兩次回傳。
+func (d *DOS) readConsoleKey() (uint8, bool) {
+	if d.consoleHasScan {
+		d.consoleHasScan = false
+		return d.consolePendingScan, true
+	}
+	word, ok := d.M.PopKey()
+	if !ok && len(d.Keys) > 0 {
+		word, ok = d.Keys[0], true
+		d.Keys = d.Keys[1:]
+	}
+	if ok {
+		d.KeysConsumed++
+		if uint8(word) == 0 {
+			d.consolePendingScan, d.consoleHasScan = uint8(word>>8), true
+		}
+		return uint8(word), true
+	}
+	if len(d.Stdin) > 0 {
+		ch := d.Stdin[0]
+		d.Stdin = d.Stdin[1:]
+		return ch, true
+	}
+	return 0, false
+}
