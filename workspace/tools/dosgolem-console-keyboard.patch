+package dos
+
+import (
+	"bytes"
+	"testing"
+
+	"github.com/wicanr2/dosgolem/internal/cpu"
+)
+
+func TestDOSConsoleReadsHardwareKeyboardOnce(t *testing.T) {
+	m, d := newTest(t)
+	if err := m.LoadCOM([]byte{0xEB, 0xFE}); err != nil {
+		t.Fatal(err)
+	}
+	d.Install()
+	m.CPU.SetFlags(cpu.IF)
+	m.KeyEvery = 20
+	m.SetNextKey(0)
+	m.QueueScanCodes(0x1E, 0x9E)
+	for i := 0; i < 100; i++ {
+		if err := m.Step(); err != nil {
+			t.Fatal(err)
+		}
+	}
+	call(m, d, 0x21, 0x0B00)
+	if uint8(m.CPU.R[cpu.AX]) != 0xFF {
+		t.Fatal("DOS 狀態看不到硬體按鍵")
+	}
+	call(m, d, 0x21, 0x0700)
+	if uint8(m.CPU.R[cpu.AX]) != 'a' || d.Blocked {
+		t.Fatal("DOS 未讀出硬體字母")
+	}
+	call(m, d, 0x21, 0x0B00)
+	if uint8(m.CPU.R[cpu.AX]) != 0 || m.BIOSKeyCount() != 0 {
+		t.Fatal("同一個鍵被讀取後仍存在")
+	}
+}
+
+func TestDOSConsoleExtendedKeySurvivesStateAndFlush(t *testing.T) {
+	m, d := newTest(t)
+	d.PushKey(Key{Scan: 0x4D})
+	call(m, d, 0x21, 0x0700)
+	if uint8(m.CPU.R[cpu.AX]) != 0 || d.Blocked {
+		t.Fatal("延伸鍵應先回 00")
+	}
+	var saved bytes.Buffer
+	if err := d.SaveState(&saved); err != nil {
+		t.Fatal(err)
+	}
+	call(m, d, 0x21, 0x0700)
+	if uint8(m.CPU.R[cpu.AX]) != 0x4D {
+		t.Fatal("第二次應回方向鍵掃描碼")
+	}
+	if err := d.LoadState(&saved); err != nil {
+		t.Fatal(err)
+	}
+	call(m, d, 0x21, 0x0B00)
+	if uint8(m.CPU.R[cpu.AX]) != 0xFF {
+		t.Fatal("狀態往返遺失待讀延伸碼")
+	}
+	call(m, d, 0x21, 0x0C00)
+	call(m, d, 0x21, 0x0B00)
+	if uint8(m.CPU.R[cpu.AX]) != 0 {
+		t.Fatal("清緩衝遺留延伸碼")
+	}
+}
+
+func TestDOSDirectConsoleInputConsumesAvailableKey(t *testing.T) {
+	m, d := newTest(t)
+	d.PushKey(Key{Scan: 0x39, ASCII: ' '})
+	m.CPU.R[cpu.DX] = 0xFF
+	call(m, d, 0x21, 0x0600)
+	if uint8(m.CPU.R[cpu.AX]) != ' ' || m.CPU.Flags&cpu.ZF != 0 {
+		t.Fatal("AH=06 未讀出空白鍵")
+	}
+	call(m, d, 0x21, 0x0600)
+	if uint8(m.CPU.R[cpu.AX]) != 0 || m.CPU.Flags&cpu.ZF == 0 || d.Blocked {
+		t.Fatal("AH=06 空讀必須不阻塞")
+	}
+}
